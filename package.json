{
  "name": "@nebutra/webhooks",
  "version": "4.0.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "nebutra": {
    "graph": "core",
    "status": "stable",
    "productionReady": true,
    "requires": [
      "WEBHOOK_SIGNING_SECRET for custom self-hosted delivery"
    ],
    "gaps": []
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./custom": {
      "types": "./dist/providers/custom.d.ts",
      "import": "./dist/providers/custom.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "import": "./dist/signing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nebutra/logger": "file:./vendor/nebutra__logger",
    "p-queue": "^9.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "@types/node": "^22.10.0"
  },
  "homepage": "https://github.com/Nebutra/webhooks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nebutra/webhooks.git"
  },
  "bugs": {
    "url": "https://github.com/Nebutra/webhooks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "nebutraMirror": {
    "sourceRepository": "Nebutra/Nebutra-Sailor",
    "sourceDirectory": "packages/integrations/webhooks",
    "sourcePackage": "@nebutra/webhooks",
    "sourceSha": "1b927886963a3e5c749b20867061bd7009b62d8b",
    "canonicalSource": "monorepo"
  },
  "packageManager": "pnpm@11.28.5"
}
